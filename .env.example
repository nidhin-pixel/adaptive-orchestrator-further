# ---------------------------------------------------------------------------
# Adaptive LLM Orchestrator - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# ---------------------------------------------------------------------------

# Primary LLM Provider (OpenAI Compatible)
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30.0

# Secondary Provider (Anthropic Claude - Provider B)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
PROVIDER_B_TIMEOUT=30.0
